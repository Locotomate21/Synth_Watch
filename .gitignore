__pycache__/
*.py[cod]
# Any venv, not just the default name: `python -m venv` writes its own
# .gitignore inside the directory, and relying on that is one deleted file
# away from committing a few hundred megabytes.
.venv*/
.env
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Never commit collected data or exported reports. Corpora describe real
# accounts and a research repo is not a place to redistribute them. The
# layout convention in data/README.md is tracked; nothing beside it is.
data/*
!data/README.md
out/
# Datasets also land wherever the download put them, so match them by name.
ioa_*.csv
*_tweets*.csv
*_users*.csv
*.parquet
*.jsonl
