__pycache__/
*.py[cod]
# Any venv, not just the default name: `python -m venv` writes its own
# .gitignore inside the directory, and relying on that is one deleted file
# away from committing a few hundred megabytes.
.venv*/
.env
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Never commit collected data or exported reports. Datasets land wherever the
# download put them, so match them by name as well as by directory.
data/
out/
ioa_*.csv
*_tweets*.csv
*_users*.csv
*.parquet
*.jsonl
